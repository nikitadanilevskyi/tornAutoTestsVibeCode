# Copy this file to `.env` and fill in real values.
# Never commit your real .env — it is in .gitignore.

# Torn account credentials used by global-setup.js to log in to the dev box.
TORN_EMAIL=your.email@example.com
TORN_PASSWORD=your-account-password

# HTTP Basic Auth for the dev environment (https://nikitad-dev.torn.com).
# Leave blank if your dev box does not require Basic Auth.
TORN_HTTP_USER=
TORN_HTTP_PASS=
